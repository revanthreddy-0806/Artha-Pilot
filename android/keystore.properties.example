# Release signing configuration for Artha Pilot (Android).
#
# Copy this file to `android/keystore.properties` and fill in your release
# keystore details. `android/keystore.properties` is gitignored and MUST
# NEVER be committed -- it contains your signing secrets.
#
# `storeFile` is resolved relative to the `android/` directory
# (e.g. `release.keystore` means `android/release.keystore`).
#
# When this file is missing or `storeFile` points to a non-existent keystore,
# release builds are produced UNSIGNED, which is not shippable. CI/release
# pipelines must provide the keystore + this file to sign reproducible
# release artifacts.
#
# Generate a keystore once and keep it safe:
#   keytool -genkeypair -v -keystore release.keystore -alias arthapilot \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -storetype PKCS12 -storepass <strong> -keypass <strong>
storeFile=release.keystore
storePassword=
keyAlias=arthapilot
keyPassword=