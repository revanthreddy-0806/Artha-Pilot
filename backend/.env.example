# Copy to .env and adjust for your environment.
# NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql+psycopg2://artha:artha_dev_password@localhost:5432/artha_pilot

# JWT
# Generate a strong random secret (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`).
# The app FAILS TO START in production if JWT_SECRET_KEY is left at a default value.
JWT_SECRET_KEY=generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array of allowed origins; "*" for development only)
CORS_ORIGINS=["*"]

# App
APP_NAME=Artha Pilot API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Uploads
MAX_UPLOAD_MB=10

# Grounded AI assistant (LLM)
# The assistant only explains verified backend data and is disabled until all
# three values below are set. The API then returns "llm_not_configured"
# (HTTP 503) instead of fabricating answers. NEVER commit a real key.
# LLM_PROVIDER=openai-compatible   # any OpenAI-compatible chat API
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=Your-Real-Key-Here
# LLM_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RESPONSE_CHARS=2400
