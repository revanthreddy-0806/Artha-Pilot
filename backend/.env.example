# Copy to .env and adjust for your environment.
# NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql+psycopg2://artha:artha_dev_password@localhost:5432/artha_pilot

# JWT
JWT_SECRET_KEY=generate-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Artha Pilot API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Uploads
MAX_UPLOAD_MB=10
UPLOAD_DIR=uploads
